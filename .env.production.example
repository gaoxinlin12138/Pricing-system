# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交
POSTGRES_DB=pricing
POSTGRES_USER=pricing
# 只用字母数字，避免 URL 编码问题；至少 16 位
POSTGRES_PASSWORD=change-me-to-a-long-password

# 生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-run-openssl-rand-hex-32

# 配好 HTTPS 之前先用 false，证书生效后改成 true 并重启后端
COOKIE_SECURE=false

# 首次启动（空库）时创建的两个账号密码，登录后请立即再改一次
INITIAL_ADMIN_PASSWORD=change-me-admin-password
INITIAL_EMPLOYEE_PASSWORD=change-me-employee-password
